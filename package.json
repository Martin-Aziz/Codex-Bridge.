{
  "name": "codex-bridge",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "npm run check && tsc -p tsconfig.json && vite build",
    "check": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.web.json",
    "test": "npm run build && node --disable-warning=ExperimentalWarning --experimental-sqlite --test dist/tests/*.test.js",
    "dev": "vite --host 127.0.0.1",
    "bridge": "node --experimental-sqlite dist/src/cli.js"
  },
  "dependencies": {
    "@openai/codex": "latest",
    "@openai/codex-sdk": "latest",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
